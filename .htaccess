# Apache — enable rewrite for this folder (some hosts need this)
# Block secrets and database dumps if this folder is the web root.
<FilesMatch "(?i)(^\.env$|^\.env\..*|config\.local\.php|.*\.(sql|log)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>

# If the site still 404s on /login, ask host to enable AllowOverride All
# or open install.php / index.php directly first.
